# macOS
.DS_Store

# Python runtime
__pycache__/
*.py[cod]

# Local collector output and diagnostics
data/
diagnostics/
*.Bruce-diagnostics.zip
.Bruce-runtime/

# Credentials and private local overrides
.env
.env.*
!.env.example
*.token
*.pat
*.secrets.json
*.pem
*.key
*.p12
*.pfx
*.kdbx
*.keychain-db
*.mobileprovision
*.sqlite
*.sqlite3
*.db

# Swift Package Manager and Xcode user state
.build/
.swiftpm/
DerivedData/
dist/
*.xcuserstate
**/xcuserdata/

# Rust build output
rust/**/target/

# AI 工具本地配置 (openspec 工作流 skills/commands, 不入库)
.agent/
.agents/
.claude/
.codex/
.kimi/
.mimosa/
.superpowers/

# OpenSpec 正式文档以 docs/openspec 为唯一真源, 需要版本控制.
# Superpowers 计划和设计仍为本地工作流产物.
docs/openspec/
!docs/openspec/
!docs/openspec/**
docs/superpowers/

# Git worktrees
.worktrees/
