{
  "$schema": "https://ad-flow.org/schemas/adflow-config.v1.json",
  "project_name": "Bruce",
  "version": "1.0",
  "doc_root": "docs/devel",
  "archive_root": "docs/archive",
  "enforcement": {
    "require_change_card": true,
    "zero_sediment": true,
    "require_evidence_anchors": true,
    "forbid_concrete_paths_in_cards": true
  },
  "topics": [
    "TokenUsage",
    "AgentUsage",
    "SubscriptionQuota",
    "MenuBarIndicator",
    "PricingEngine",
    "CredentialSecurity"
  ],
  "test_suites": {
    "verify_local": "zsh scripts/verify-local.sh",
    "rust_tests": "cargo test --manifest-path rust/Bruce-collector/Cargo.toml --workspace",
    "swift_harness": "swift run --package-path macos/BruceApp BruceOnboardingCoreHarness"
  }
}
