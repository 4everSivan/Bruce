{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "commands-preview",
  "description": "Tray hover preview card: only the commands preview.js invokes",
  "windows": [
    "preview"
  ],
  "local": true,
  "permissions": [
    "allow-expand-dashboard",
    "allow-get-dashboard",
