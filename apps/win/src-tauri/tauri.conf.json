{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bruce",
  "version": "0.15.0",
  "identifier": "com.bruce.dashboard.win",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "dashboard",
        "title": "Bruce",
        "width": 440,
        "height": 760,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "alwaysOnTop": true
      },
      {
        "label": "settings",
        "title": "Bruce 设置",
        "url": "settings.html",
        "width": 1000,
        "height": 680,
        "minWidth": 980,
        "minHeight": 620,
        "visible": false,
        "resizable": true,
        "center": true
      },
      {
        "label": "preview",
        "title": "Bruce 实时预览",
        "url": "preview.html",
        "width": 420,
        "height": 260,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "alwaysOnTop": true
      },
      {
        "label": "quota-alert",
        "title": "Bruce 配额预警",
        "url": "quota-alert.html",
        "width": 300,
        "height": 90,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "alwaysOnTop": true,
        "focusable": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDODk4ODBDNjcyRDdDMzMKUldRemZDMW5ESWlKUEFTeXdGbmdjVlFzZzZKbGh6R1NObEMxQjY0TG81cU5VOE5sNDVMbVVvb3gK",
      "endpoints": [
        "https://github.com/4everSivan/Bruce/releases/latest/download/latest.json"
      ]
    }
  }
}
