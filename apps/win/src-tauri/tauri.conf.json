{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bruce",
  "version": "0.11.0",
  "identifier": "com.bruce.dashboard.win",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "dashboard",
        "title": "Bruce",
        "width": 440,
        "height": 760,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "alwaysOnTop": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
