{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mddd.local/schemas/artifacts/github-v1.schema.json",
  "title": "mddd GitHub contribution artifact v1",
  "$ref": "#/$defs/contribution",
  "$defs": {
    "contribution": {
      "type": "object",
      "required": [
        "schemaVersion",
        "module",
        "generatedAt",
        "login",
        "totalContributions",
        "today",
        "currentStreak",
        "longestStreak",
        "bestDay",
        "weeks"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "module": {
          "const": "github"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "login": {
          "type": "string"
        },
        "totalContributions": {
          "type": "integer",
          "minimum": 0
        },
        "today": {
          "type": "integer",
          "minimum": 0
        },
        "currentStreak": {
          "type": "integer",
          "minimum": 0
        },
        "longestStreak": {
          "type": "integer",
          "minimum": 0
        },
        "bestDay": {
          "type": [
            "object",
            "null"
          ]
        },
        "weeks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/week"
          }
        }
      }
    },
    "week": {
      "type": "object",
      "required": [
        "days"
      ],
      "properties": {
        "days": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/day"
          }
        }
      }
    },
    "day": {
      "type": "object",
      "required": [
        "date",
        "count",
        "level",
        "weekday"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "level": {
          "type": "string"
        },
        "weekday": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      }
    }
  }
}
