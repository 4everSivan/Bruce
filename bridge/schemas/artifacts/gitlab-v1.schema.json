{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mddd.local/schemas/artifacts/gitlab-v1.schema.json",
  "title": "mddd GitLab contribution artifact v1",
  "allOf": [
    {
      "$ref": "github-v1.schema.json#/$defs/contribution"
    },
    {
      "type": "object",
      "required": [
        "displayName"
      ],
      "properties": {
        "module": {
          "const": "gitlab"
        },
        "displayName": {
          "type": "string"
        }
      }
    }
  ]
}
