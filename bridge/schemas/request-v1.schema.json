{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mddd.local/schemas/bridge/request-v1.schema.json",
  "title": "mddd Bridge v1 request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "module",
    "timeouts",
    "context",
    "credentials"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "context": {
            "required": [
              "codexQuotaAccountOrder"
            ]
          }
        },
        "required": [
          "context"
        ]
      },
      "then": {
        "properties": {
          "credentials": {
            "required": [
              "codexQuotaAccounts"
            ]
          }
        },
        "required": [
          "credentials"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "credentials": {
            "required": [
              "codexQuotaAccounts"
            ]
          }
        },
        "required": [
          "credentials"
        ]
      },
      "then": {
        "properties": {
          "context": {
            "required": [
              "codexQuotaAccountOrder"
            ]
          }
        },
        "required": [
          "context"
        ]
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "module": {
      "enum": [
        "agent-usage"
      ]
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localScanSeconds",
        "externalRequestSeconds",
        "moduleSeconds"
      ],
      "properties": {
        "localScanSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        },
        "externalRequestSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        },
        "moduleSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": {
          "type": "string",
          "minLength": 1
        },
        "now": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 366
        },
        "paths": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "localSessions",
              "localPricing",
              "externalQuotas"
            ]
          },
          "uniqueItems": true
        },
        "codexQuotaRetryOnly": {
          "type": "boolean"
        },
        "codexQuotaAccountOrder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 64,
          "uniqueItems": true
        }
      }
    },
    "credentials": {
      "$ref": "#/$defs/credentials"
    }
  },
  "$defs": {
    "quotaAccounts": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "oauthTokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "access_token": {
          "type": "string"
        },
        "refresh_token": {
          "type": "string"
        },
        "id_token": {
          "type": "string"
        },
        "expiry": {
          "type": "string"
        }
      }
    },
    "codexQuotaAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "access_token"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "access_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kimiWebTokens": {
          "$ref": "#/$defs/oauthTokens"
        },
        "kimiQuotaAccounts": {
          "$ref": "#/$defs/quotaAccounts"
        },
        "deepseekQuotaAccounts": {
          "$ref": "#/$defs/quotaAccounts"
        },
        "volcengineQuotaAccounts": {
          "$ref": "#/$defs/quotaAccounts"
        },
        "antigravityQuotaAccounts": {
          "$ref": "#/$defs/quotaAccounts"
        },
        "claudeQuotaAccounts": {
          "$ref": "#/$defs/quotaAccounts"
        },
        "grokQuotaAccounts": {
          "$ref": "#/$defs/quotaAccounts"
        },
        "codexQuotaAccounts": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/codexQuotaAccount"
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "orcaCodexAuth": {
          "type": "object"
        },
        "antigravityOAuth": {
          "type": "object"
        },
        "providerEnv": {
          "type": "object"
        },
        "providerMeta": {
          "type": "object"
        }
      }
    }
  }
}
