{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bruce.local/schemas/artifacts/agent-usage-v1.schema.json",
  "title": "Bruce Agent usage artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "module",
    "generatedAt",
    "agents",
    "services",
    "totalCostUsd"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "module": {
      "const": "agent-usage"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/service"
      }
    },
    "totalCostUsd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  },
  "$defs": {
    "tokenBucket": {
      "type": "object",
      "required": [
        "input",
        "output",
        "cacheRead",
        "cacheCreation",
        "total"
      ],
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "cacheRead": {
          "type": "integer",
          "minimum": 0
        },
        "cacheCreation": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "daily": {
      "type": "object",
      "required": [
        "date",
        "input",
        "output",
        "total"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "cacheRead": {
          "type": "integer",
          "minimum": 0,
          "description": "原始缓存读取 token (C070); input 为含缓存的展示口径, 原始输入 = input − cacheRead − cacheCreation"
        },
        "cacheCreation": {
          "type": "integer",
          "minimum": 0,
          "description": "原始缓存写入 token (C070)"
        }
      }
    },
    "agent": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "today",
        "daily",
        "hours"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "quota": {},
        "today": {
          "$ref": "#/$defs/tokenBucket"
        },
        "daily": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/daily"
          }
        },
        "models": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "todayModels": {
          "type": "array"
        },
        "projects": {
          "type": "array"
        },
        "hours": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "todayCostUsd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "modelMonths": {
          "type": "object",
          "description": "自然月 × 模型 token 总量, 供用量卡模型分档统计 (本月/3 月/6 月)",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "dailyModels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dailyModel"
          }
        },
        "monthModels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/monthModel"
          }
        },
        "hourModels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hourModel"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "windows"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "windows": {
          "type": "array"
        }
      }
    },
    "dailyModel": {
      "type": "object",
      "description": "日期 × 模型 token 桶 (原始口径), 只覆盖截至今日最近 31 天 (C070)",
      "required": [
        "date",
        "model",
        "input",
        "output",
        "cacheRead",
        "cacheCreation",
        "total",
        "costUsd",
        "cacheSavingsUsd"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "model": {
          "type": "string"
        },
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "cacheRead": {
          "type": "integer",
          "minimum": 0
        },
        "cacheCreation": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "costUsd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "采集端按 PricingTable 计价; 无匹配单价为 null"
        },
        "cacheSavingsUsd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "缓存读取 × (输入单价 − 缓存读取单价)"
        }
      }
    },
    "monthModel": {
      "type": "object",
      "description": "自然月 × 模型 token 桶, 覆盖采集窗口全部月份 (C070)",
      "required": [
        "month",
        "model",
        "input",
        "output",
        "cacheRead",
        "cacheCreation",
        "total",
        "costUsd",
        "cacheSavingsUsd"
      ],
      "properties": {
        "month": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "model": {
          "type": "string"
        },
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "cacheRead": {
          "type": "integer",
          "minimum": 0
        },
        "cacheCreation": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "costUsd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "采集端按 PricingTable 计价; 无匹配单价为 null"
        },
        "cacheSavingsUsd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "缓存读取 × (输入单价 − 缓存读取单价)"
        }
      }
    },
    "hourModel": {
      "type": "object",
      "description": "今日 小时 × 模型 token 桶 (C070)",
      "required": [
        "hour",
        "model",
        "input",
        "output",
        "cacheRead",
        "cacheCreation",
        "total",
        "costUsd",
        "cacheSavingsUsd"
      ],
      "properties": {
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "model": {
          "type": "string"
        },
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "cacheRead": {
          "type": "integer",
          "minimum": 0
        },
        "cacheCreation": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "costUsd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "采集端按 PricingTable 计价; 无匹配单价为 null"
        },
        "cacheSavingsUsd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "缓存读取 × (输入单价 − 缓存读取单价)"
        }
      }
    }
  }
}