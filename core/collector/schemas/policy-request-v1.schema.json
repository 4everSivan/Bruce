{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bruce.local/schemas/policy/request-v1.schema.json",
  "title": "Bruce collector policy v1 request",
  "description": "共享策略入口的请求 (T14 定义, T17 扩展边界唤醒与退避, design/08): mac 经静态库 collector-policy-ffi 的 C ABI (bruce_policy_call, T16) 进程内调用, 实现为 collector_policy::handle_request。只含 artifact.services 与时间 / 间隔等纯数据, 不携带凭据: 任意层级出现凭据形态的键 (token / secret / password / apiKey / cookie / authorization / credential / oauth / *QuotaAccounts) 时以 POLICY_CREDENTIAL_FIELD_REJECTED 拒绝。",
  "type": "object",
  "required": ["schemaVersion", "operation"],
  "oneOf": [
    {
      "title": "quotaPlan: 本轮额度门禁",
      "additionalProperties": false,
      "required": ["now", "intervalSeconds", "forceRefresh", "bypassCooldown", "suppressExternalQuotas"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "operation": { "const": "quotaPlan" },
        "now": { "$ref": "#/$defs/timestamp" },
        "previousServices": { "$ref": "#/$defs/servicesOrNull" },
        "enabledProviders": {
          "description": "本轮启用的 provider; null / 缺省表示未知, 沿用上一份中出现的 provider",
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "intervalSeconds": { "type": "integer", "description": "额度查询周期; <= 0 表示不做新鲜度门禁" },
        "forceRefresh": { "type": "boolean" },
        "bypassCooldown": { "type": "boolean" },
        "suppressExternalQuotas": { "type": "boolean", "description": "锁屏等场景强制抑制外部额度查询 (C064 / C071)" }
      }
    },
    {
      "title": "quotaMerge: 本轮额度回填",
      "additionalProperties": false,
      "required": ["now", "currentServices", "policy", "intervalSeconds"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "operation": { "const": "quotaMerge" },
        "now": { "$ref": "#/$defs/timestamp" },
        "previousServices": { "$ref": "#/$defs/servicesOrNull" },
        "currentServices": { "$ref": "#/$defs/services" },
        "policy": { "$ref": "#/$defs/quotaRunPolicy" },
        "intervalSeconds": { "type": "integer" }
      }
    },
    {
      "title": "quotaAnnotate: 定向刷新尝试时间戳",
      "additionalProperties": false,
      "required": ["now", "services", "serviceIds"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "operation": { "const": "quotaAnnotate" },
        "now": { "$ref": "#/$defs/timestamp" },
        "services": { "$ref": "#/$defs/services" },
        "serviceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    {
      "title": "boundaryIds: 从 services 提取窗口重置时刻",
      "additionalProperties": false,
      "required": ["services"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "operation": { "const": "boundaryIds" },
        "services": { "$ref": "#/$defs/services" }
      }
    },
    {
      "title": "boundaryWake: 下次唤醒间隔 (窗口边界唤醒, T17)",
      "additionalProperties": false,
      "required": ["interval", "boundaries", "now"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "operation": { "const": "boundaryWake" },
        "interval": { "type": "number", "minimum": 0, "description": "原定时刷新间隔 (秒)" },
        "boundaries": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "窗口重置时刻 (epoch 秒)"
        },
        "now": { "type": "number", "description": "当前时间 (epoch 秒, 可含小数)" },
        "slack": { "type": "number", "minimum": 0, "default": 20 },
        "consumed": {
          "type": "array",
          "items": { "type": "integer" },
          "uniqueItems": true,
          "description": "已消费的边界值; 命中后由响应返回更新后的集合"
        }
      }
    },
    {
      "title": "backoff: 刷新退避秒数 (T17)",
      "additionalProperties": false,
      "required": ["retryCount", "rateLimited", "base", "max", "rateLimit"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "operation": { "const": "backoff" },
        "retryCount": { "type": "integer", "minimum": 0 },
        "rateLimited": { "type": "boolean" },
        "base": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 },
        "rateLimit": { "type": "number", "minimum": 0 },
        "jitterFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "抖动比例 (capped 的 0~0.1); 由调用方注入以便测试确定性"
        }
      }
    }
  ],
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "services": {
      "description": "agent-usage artifact 的 services (见 artifacts/agent-usage-v1 的 $defs.service)",
      "type": "array",
      "items": { "type": "object" }
    },
    "servicesOrNull": {
      "description": "上一份 artifact 的 services; null / 缺省表示无上一份",
      "type": ["array", "null"],
      "items": { "type": "object" }
    },
    "quotaRunPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includeExternalQuotas", "skipProviders", "rateLimitedProviders"],
      "properties": {
        "includeExternalQuotas": { "type": "boolean" },
        "skipProviders": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "rateLimitedProviders": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
