{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bruce.local/schemas/bridge/request-v1.schema.json",
  "title": "Bruce Bridge v1 request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "module",
    "timeouts",
    "context",
    "credentials"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "context": {
            "required": [
              "codexQuotaAccountOrder"
            ]
          }
        },
        "required": [
          "context"
        ]
      },
      "then": {
        "properties": {
          "credentials": {
            "required": [
              "codexQuotaAccounts"
            ]
          }
        },
        "required": [
          "credentials"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "credentials": {
            "required": [
              "codexQuotaAccounts"
            ]
          }
        },
        "required": [
          "credentials"
        ]
      },
      "then": {
        "properties": {
          "context": {
            "required": [
              "codexQuotaAccountOrder"
            ]
          }
        },
        "required": [
          "context"
        ]
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "module": {
      "enum": [
        "agent-usage"
      ]
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalRequestSeconds",
        "moduleSeconds"
      ],
      "properties": {
        "localScanSeconds": {
          "deprecated": true,
          "description": "C177 退役：从未被 Collector 消费，宿主不再发送；为兼容旧宿主仍接受，解析时丢弃且不校验取值。本机扫描只受 moduleSeconds 约束。"
        },
        "externalRequestSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        },
        "moduleSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": {
          "type": "string",
          "minLength": 1
        },
        "now": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 366
        },
        "paths": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "localSessions",
              "externalQuotas"
            ]
          },
          "uniqueItems": true
        },
        "quotaRetryOnly": {
          "type": "boolean"
        },
        "codexQuotaAccountOrder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "pricingCatalog": {
          "type": "object",
          "description": "运行期从 GitHub 在线同步生效的模型价格表 (T19)",
          "properties": {
            "schemaVersion": {
              "type": "integer"
            },
            "updatedAt": {
              "type": "string"
            },
            "models": {
              "type": "array"
            }
          }
        },
        "pricingOverrides": {
          "type": "object",
          "description": "用户自定义模型价格覆盖"
        },
        "localUsageOnly": {
          "type": "boolean"
        },
        "quotaSkipProviders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "egressRules": {
          "type": "object",
          "description": "按服务商提供国家代码及专用回环 HTTP 代理端口；空端口由采集端阻断。",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["country", "port"],
            "properties": {
              "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
              "port": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535}
            }
          }
        }
      }
    },
    "credentials": {
      "$ref": "#/$defs/credentials"
    }
  },
  "$defs": {
    "quotaAccounts": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "grokBotQuotaAccounts": {
      "type": "object",
      "description": "T39: 已连接的 Grok Bot 客户端账号 (design/02 规则 18); 键为 sha256(account) 十六进制前 16 位, data_dir 由 Collector 注入, 不由调用方提供",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "display_name",
          "account"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "account": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[0-9a-f]{16}$"
      }
    },
    "codexQuotaAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "access_token"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "access_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kimiQuotaAccounts": {
          "$ref": "#/$defs/quotaAccounts"
        },
        "deepseekQuotaAccounts": {
          "$ref": "#/$defs/quotaAccounts"
        },
        "volcengineQuotaAccounts": {
          "$ref": "#/$defs/quotaAccounts"
        },
        "zhipuQuotaAccounts": {
          "$ref": "#/$defs/quotaAccounts"
        },
        "claudeQuotaAccounts": {
          "$ref": "#/$defs/quotaAccounts"
        },
        "grokQuotaAccounts": {
          "$ref": "#/$defs/quotaAccounts"
        },
        "codexQuotaAccounts": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/codexQuotaAccount"
          },
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "stepfunQuotaAccounts": {
          "$ref": "#/$defs/quotaAccounts"
        },
        "jevQuotaAccounts": {
          "$ref": "#/$defs/quotaAccounts"
        },
        "clineQuotaAccounts": {
          "$ref": "#/$defs/quotaAccounts"
        },
        "grokBotQuotaAccounts": {
          "$ref": "#/$defs/grokBotQuotaAccounts"
        },
        "providerMeta": {
          "type": "object"
        }
      }
    }
  }
}
