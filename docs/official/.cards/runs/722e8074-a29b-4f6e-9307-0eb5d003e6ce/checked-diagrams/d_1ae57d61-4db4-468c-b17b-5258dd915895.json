  "evidence": {
    "cli": {
      "path": "core/collector/bin/Bruce-collector/src/main.rs",
      "locator": "main",
      "kind": "static_implementation",
      "supports": "main 读取 stdin，调用 Bridge，将一份响应写 stdout 并退出。"
    },
    "bridge": {
      "path": "core/collector/crates/collector-bridge/src/lib.rs",
      "locator": "run_bytes; validate_request; validate_response_credentials",
      "kind": "static_implementation",
      "supports": "Bridge 校验请求；无效请求不调用应用；应用结果形成 BridgeResponse，凭据输出经校验。"
    },
    "parallel": {
      "path": "core/collector/crates/collector-application/src/lib.rs",
      "locator": "collect_agent_usage_with_dependencies_inner",
      "kind": "static_implementation",
      "supports": "普通分支创建本地线程，仅在 localUsageOnly 不为 true 且 externalQuotas 允许时创建额度线程；该图不覆盖更早返回的 Codex 定向重试分支。"
    },
    "local": {
      "path": "core/collector/crates/collector-application/src/lib.rs",
      "locator": "collect_local_usage; finalize_local_agent; local_source_runtime_diagnostic",
      "kind": "static_implementation",
      "supports": "localSessions 控制扫描；未授权形成不可用占位；本地取消或超时返回错误并在发布前检查，普通源故障可保留结果。"
    },
    "quotas": {
      "path": "core/collector/crates/collector-application/src/execution.rs",
      "locator": "execute_quota_accounts; execute_one_uncached",
      "kind": "static_implementation",
      "supports": "额度按账号执行并汇总服务、诊断、凭据更新、凭据挑战，单账号错误成为服务错误。"
    },
    "assemble": {
      "path": "core/collector/crates/collector-application/src/lib.rs",
      "locator": "collect_agent_usage_with_dependencies_inner",
      "kind": "static_implementation",
      "supports": "localUsageOnly=true 时 services 和额度凭据输出为空；否则额度未授权时生成 denied_service 占位。正常本地数据应用定价并与服务合成工件，本地取消或错误不发布工件。"
    },
    "status": {
      "path": "core/collector/crates/collector-domain/src/lib.rs",
      "locator": "response_status; BridgeResponse::error",
      "kind": "static_implementation",
      "supports": "无 artifact 为 error；存在非行数截断诊断为 partial；无诊断或仅截断为 success。"
    },
    "limits": {
      "path": "core/collector/crates/collector-runtime/src/lib.rs",
      "locator": "RuntimeLimits::default",
      "kind": "static_implementation",
      "supports": "账号工作线程上限为 account_tasks=4。"
    }
