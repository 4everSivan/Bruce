  "evidence": {
    "phases": {
      "path": "apps/macos/Sources/BruceAppCore/RefreshScheduler.swift",
      "locator": "ModuleScheduleState.Phase; ModuleScheduleState.phase",
      "kind": "static_implementation",
      "supports": "模块有 disabled、idle、running、backoff、authRequired 五种相位，默认 disabled。"
    },
    "enable": {
      "path": "apps/macos/Sources/BruceAppCore/RefreshScheduler.swift",
      "locator": "enableModule; disableModule",
      "kind": "static_implementation",
      "supports": "启用将 disabled 转 idle；禁用将任意相位置 disabled，清 pending 并取消模块定时器，不直接取消进程。 图的常规路径未展开禁用后的在途收尾；applyCompleted 等不检查 enabled，正文另述其仍可改相位但不能启动新任务。"
    },
    "trigger": {
      "path": "apps/macos/Sources/BruceAppCore/RefreshScheduler.swift",
      "locator": "triggerRefresh; startRefresh",
      "kind": "static_implementation",
      "supports": "正常触发要求未整体停止且模块启用，authRequired 仅接受手动意图；容量允许时进入 running，否则合并 pending。"
    },
    "completed": {
      "path": "apps/macos/Sources/BruceAppCore/RefreshScheduler.swift",
      "locator": "applyCompleted; handleBackoff; finishCycle",
      "kind": "static_implementation",
      "supports": "发布成功回 idle；失败计数超过 maxBackoffRetries 也回 idle、计数归零并排正常周期；idle 收尾先 drain pending。"
    },
    "failure": {
      "path": "apps/macos/Sources/BruceAppCore/RefreshScheduler.swift",
      "locator": "handleRunInputFailure; applyCollectorFailure; applyStorageFailure; applyCompleted; handleBackoff",
      "kind": "static_implementation",
      "supports": "授权缺失进入 authRequired，Bridge 无 artifact 的 auth 或 status.error 被分类为 auth 也进入 authRequired；其他失败按计数进入 backoff。"
    },
    "cancel": {
      "path": "apps/macos/Sources/BruceAppCore/RefreshScheduler.swift",
      "locator": "handleCancellation",
      "kind": "static_implementation",
      "supports": "取消后清 pending，有历史成功回 idle 并显示 stale，否则进入 disabled 并显示 notConfigured。"
    },
    "retry": {
      "path": "apps/macos/Sources/BruceAppCore/RefreshScheduler.swift",
      "locator": "handleBackoff; SchedulerConfiguration.default",
      "kind": "static_implementation",
      "supports": "至多5次退避，回调 startRefresh 仍要求模块 enabled；重试 scope.all，保留手动属性。"
    },
    "policy": {
      "path": "apps/macos/Sources/BruceAppCore/RefreshBackoffPolicy.swift",
      "locator": "RefreshBackoffPolicy.computeBackoff",
      "kind": "static_implementation",
      "supports": "限流固定300秒；其他基数30秒指数退避加抖动、封顶1800秒。"
    }
  }
