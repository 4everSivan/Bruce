  "evidence": {
    "default":{"path":"apps/win/src-tauri/src/runtime_core.rs","locator":"impl Default for SnapshotState","kind":"static_implementation","supports":"默认 phase 为 idle，artifact、last_success_at、error 均为空。"},
    "load":{"path":"apps/win/src-tauri/src/runtime_core.rs","locator":"SnapshotState::load","kind":"static_implementation","supports":"快照缺失返回默认值；读取或内容无效为 failed；有效状态通过 fail(SNAPSHOT_RESTORED) 恢复，结果依 artifact 是否存在分为 stale 或 failed。"},
    "begin":{"path":"apps/win/src-tauri/src/runtime_core.rs","locator":"SnapshotState::begin_refresh","kind":"static_implementation","supports":"开始刷新只把 phase 设为 refreshing，其他字段不清空。"},
    "apply":{"path":"apps/win/src-tauri/src/runtime_core.rs","locator":"SnapshotState::apply_response","kind":"static_implementation","supports":"Error、缺失或无效 artifact 走 fail；有效 Success/Partial 合并数据后分别设置 fresh/partial；仅 Success 更新 last_success_at。"},
    "fail":{"path":"apps/win/src-tauri/src/runtime_core.rs","locator":"SnapshotState::fail","kind":"static_implementation","supports":"artifact 存在时 phase 为 stale，否则为 failed；保留内存数据并把合资格服务标为 stale。"},
    "scheduler":{"path":"apps/win/src-tauri/src/scheduler.rs","locator":"run_refresh_with_kind 与 spawn","kind":"static_implementation","supports":"循环在每次采集前 begin_refresh；结果应用后尝试保存，保存失败调用 fail(SNAPSHOT_WRITE_FAILED)；采集返回错误调用 fail(COLLECTION_FAILED)。"}
