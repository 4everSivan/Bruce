    {
      "name": "union_multiple_error_subscriptions_names_each_service_once",
      "moduleState": "fresh",
      "subscriptions": [
        {
          "status": "error",
          "name": "Codex"
        },
        {
          "status": "partial",
          "name": "Kimi"
        },
        {
          "status": "failed",
          "name": "DeepSeek"
        },
        {
          "status": "error",
          "name": "Codex"
        }
      ],
      "hasData": true,
      "detail": null,
      "expectedTone": "error",
      "expectedRefreshing": false,
      "expectedReason": "失败 · Codex、DeepSeek"
    },
    {
      "name": "union_subscription_worst_without_name_shows_label_only",
      "moduleState": "fresh",
      "subscriptions": [
        {
          "status": "partial",
          "name": "  "
        }
      ],
      "hasData": true,
      "detail": null,
      "expectedTone": "warn",
      "expectedRefreshing": false,
      "expectedReason": "部分失败"
    },
    {
      "name": "tie_between_collection_and_subscription_keeps_collection_detail",
      "moduleState": "partial",
      "subscriptions": [
        {
          "status": "partial",
          "name": "Kimi"
        }
      ],
      "hasData": true,
      "detail": "Gemini 会话目录不可读",
      "expectedTone": "warn",
      "expectedRefreshing": false,
      "expectedReason": "部分失败 · Gemini 会话目录不可读"
