    {
      "name": "refreshing_with_data_and_ok_subscriptions_pulses_green",
      "moduleState": "refreshing",
      "subscriptions": [
        {
          "status": "ok",
          "name": "Kimi"
        }
      ],
      "hasData": true,
      "detail": null,
      "expectedTone": "ok",
      "expectedRefreshing": true,
