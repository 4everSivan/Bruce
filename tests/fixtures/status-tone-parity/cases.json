{
  "description": "C100 双端仪表盘顶部四色状态灯 (DashboardStatusTone) 共享对拍用例; detail 只描述采集侧, 订阅侧更严重时原因点名服务",
  "cases": [
    {
      "name": "mac_fresh_healthy",
      "moduleState": "fresh",
      "subscriptions": [
        {
          "status": "ok",
          "name": "Kimi"
        },
        {
          "status": "ok",
          "name": "Codex"
        }
      ],
      "hasData": true,
      "detail": null,
      "expectedTone": "ok",
      "expectedRefreshing": false,
      "expectedReason": "运行正常"
    },
    {
      "name": "mac_ready_no_subscriptions",
      "moduleState": "ready",
      "subscriptions": [],
      "hasData": false,
      "detail": null,
      "expectedTone": "ok",
      "expectedRefreshing": false,
      "expectedReason": "运行正常"
    },
    {
      "name": "win_ok_healthy",
      "moduleState": "ok",
      "subscriptions": [
        {
          "status": "ok",
          "name": "Kimi"
        }
      ],
      "hasData": true,
      "detail": null,
      "expectedTone": "ok",
      "expectedRefreshing": false,
      "expectedReason": "运行正常"
    },
    {
      "name": "win_idle_with_data_is_ok",
      "moduleState": "idle",
      "subscriptions": [
        {
          "status": "ok",
          "name": "Kimi"
        }
      ],
      "hasData": true,
      "detail": null,
      "expectedTone": "ok",
      "expectedRefreshing": false,
      "expectedReason": "运行正常"
    },
    {
      "name": "win_idle_without_data_is_neutral",
      "moduleState": "idle",
      "subscriptions": [],
      "hasData": false,
      "detail": null,
      "expectedTone": "neutral",
      "expectedRefreshing": false,
      "expectedReason": "暂无数据"
    },
    {
      "name": "win_empty_first_boot_is_neutral",
      "moduleState": "empty",
      "subscriptions": [],
      "hasData": false,
      "detail": null,
      "expectedTone": "neutral",
      "expectedRefreshing": false,
      "expectedReason": "暂无数据"
    },
    {
      "name": "mac_not_configured_without_detail",
      "moduleState": "notConfigured",
      "subscriptions": [],
      "hasData": false,
      "detail": null,
      "expectedTone": "neutral",
      "expectedRefreshing": false,
      "expectedReason": "未配置"
    },
    {
      "name": "mac_not_configured_with_detail",
      "moduleState": "notConfigured",
      "subscriptions": [],
      "hasData": false,
      "detail": "尚未完成授权",
      "expectedTone": "neutral",
      "expectedRefreshing": false,
      "expectedReason": "未配置 · 尚未完成授权"
    },
    {
      "name": "partial_with_detail_is_warn",
      "moduleState": "partial",
      "subscriptions": [
        {
          "status": "ok",
          "name": "Kimi"
        }
      ],
      "hasData": true,
      "detail": "Kimi 请求触发限流",
      "expectedTone": "warn",
      "expectedRefreshing": false,
      "expectedReason": "部分失败 · Kimi 请求触发限流"
    },
    {
      "name": "stale_without_detail_is_warn",
      "moduleState": "stale",
      "subscriptions": [
        {
          "status": "ok",
          "name": "Kimi"
        }
      ],
      "hasData": true,
      "detail": null,
      "expectedTone": "warn",
      "expectedRefreshing": false,
      "expectedReason": "数据过期"
    },
    {
      "name": "stale_with_detail_is_warn",
      "moduleState": "stale",
      "subscriptions": [
        {
          "status": "ok",
