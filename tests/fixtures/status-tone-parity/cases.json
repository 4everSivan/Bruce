      "expectedTone": "error",
      "expectedRefreshing": false,
      "expectedReason": "不可用 · Collector 进程不可用"
    },
    {
      "name": "union_fresh_module_with_partial_subscription_elevates_to_warn",
      "moduleState": "fresh",
      "subscriptions": [
        {
          "status": "ok",
          "name": "Kimi"
        },
        {
          "status": "partial",
          "name": "Codex"
        }
      ],
      "hasData": true,
      "detail": null,
      "expectedTone": "warn",
      "expectedRefreshing": false,
      "expectedReason": "部分失败 · Codex"
    },
    {
      "name": "union_fresh_module_with_error_subscription_elevates_to_error",
      "moduleState": "fresh",
      "subscriptions": [
        {
          "status": "ok",
          "name": "Kimi"
        },
        {
          "status": "error",
          "name": "Codex"
        }
      ],
      "hasData": true,
      "detail": null,
      "expectedTone": "error",
      "expectedRefreshing": false,
      "expectedReason": "失败 · Codex"
    },
    {
      "name": "union_partial_module_with_error_subscription_names_service_not_collection_detail",
      "moduleState": "partial",
      "subscriptions": [
        {
          "status": "partial",
